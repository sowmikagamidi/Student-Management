    <script src="../assets/js/rightpanel.js"></script>
    <script>
        toastr.options = { closeButton: true, progressBar: true, positionClass: "toast-top-right", timeOut: "4000", preventDuplicates: true };
        const API_BASE = 'http://localhost/school_management/api/';
        
        function escapeHtml(str) { if (!str) return ''; return String(str).replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m])); }
        
        function showFieldError(inputId, message) {
            const input = document.getElementById(inputId);
            if (input) { 
                input.classList.add('error'); 
                let errorDiv = input.parentElement.querySelector('.error-message');
                if (!errorDiv) { 
                    errorDiv = document.createElement('div'); 
                    errorDiv.className = 'error-message'; 
                    input.parentElement.appendChild(errorDiv); 
                } 
                errorDiv.style.display = 'block'; 
                errorDiv.innerHTML = message;
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                toastr.error(message);
            }
        }
        
        function clearFieldError(inputId) {
            const input = document.getElementById(inputId);
            if (input) { 
                input.classList.remove('error'); 
                const errorDiv = input.parentElement.querySelector('.error-message'); 
                if (errorDiv) { 
                    errorDiv.style.display = 'none'; 
                    errorDiv.innerHTML = ''; 
                } 
            }
        }
        
        function clearAllErrors(formId) {
            const form = document.getElementById(formId);
            if (form) { 
                form.querySelectorAll('input, select, textarea').forEach(input => { 
                    input.classList.remove('error'); 
                    const errorDiv = input.parentElement.querySelector('.error-message'); 
                    if (errorDiv) { 
                        errorDiv.style.display = 'none'; 
                        errorDiv.innerHTML = ''; 
                    } 
                }); 
            }
        }
        
        function validateRequired(inputId, fieldName) {
            const input = document.getElementById(inputId);
            if (input && !input.value.trim()) { 
                showFieldError(inputId, `${fieldName} is required`); 
                return false; 
            }
            clearFieldError(inputId); 
            return true;
        }
        
        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }
        
        function validatePhone(phone) {
            const re = /^\d{10}$/;
            return re.test(phone);
        }
        
        const PANEL_WIDTHS = { school: '500px', classes: '550px', licence: '600px', tv: '700px', api: '600px', lms: '660px', user: '700px' };
        let activeTVContext = null, activeLMSContext = null, activeAPIContext = null, activeClassesContext = null;
        
        function openPanel(title, contentHtml, onClose, width = '720px', icon = '📄') {
            return RightPanel.open({ title, icon, width, html: contentHtml, onClose });
        }
        
        function closePanel() {
            RightPanel.closeTop();
        }

        function refreshActiveTVPanel() {
            if (!activeTVContext) return;
            closePanel();
            setTimeout(() => openTVSection(activeTVContext.schoolId, activeTVContext.schoolName), 350);
        }
        
        function refreshActiveLMSPanel() {
            if (!activeLMSContext) return;
            closePanel();
            setTimeout(() => openLMSSection(activeLMSContext.schoolId, activeLMSContext.schoolName), 350);
        }
        
        function refreshActiveAPIPanel() {
            if (!activeAPIContext) return;
            closePanel();
            setTimeout(() => openAPIKeysSection(activeAPIContext.schoolId, activeAPIContext.schoolName), 350);
        }
        
        function refreshActiveClassesPanel() {
            if (!activeClassesContext) return;
            closePanel();
            setTimeout(() => manageClasses(activeClassesContext.schoolId, activeClassesContext.schoolName), 350);
        }
        
        async function createSchool(data) {
            const res = await fetch(API_BASE + 'school_create.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            return await res.json();
        }
        
        async function updateSchool(data) {
            const res = await fetch(API_BASE + 'school_update.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            return await res.json();
        }

        function getBoardName(boardId) {
            return ({ C: 'CBSE', I: 'ICSE', W: 'WBBSE' }[boardId] || boardId || '-');
        }

        // Replace the renderUserHistoryTable function
function renderUserHistoryTable(users) {
    if (!users || users.length === 0) return '<p>No users found.</p>';
    return `<div style="overflow-x: auto;">
        <table style="width:100%; font-size:13px; border-collapse: collapse;">
            <thead>
                <tr style="background:#f8f9fa;">
                    <th style="padding:10px;">User ID</th>
                    <th style="padding:10px;">Full Name</th>
                    <th style="padding:10px;">Username</th>
                    <th style="padding:10px;">Email</th>
                    <th style="padding:10px;">Mobile</th>
                    <th style="padding:10px;">Gender</th>
                    <th style="padding:10px;">Role</th>
                    <th style="padding:10px;">Status</th>
                    <th style="padding:10px;">Class</th>
                    <th style="padding:10px;">Batch</th>
                    <th style="padding:10px;">Subscription</th>
                    <th style="padding:10px;">Joining Date</th>
                    <th style="padding:10px;">Expiry Date</th>
                    <th style="padding:10px;">Created</th>
                    <th style="padding:10px;">Actions</th>
                 </tr>
            </thead>
            <tbody>
                ${users.map(u => `
                     <tr>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.user_id || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${escapeHtml(u.display_name || u.full_name || u.name || '-')}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${escapeHtml(u.user_name || '-')}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${escapeHtml(u.display_email || u.email_id || u.email || '-')}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.display_mobile || u.mobile_number || u.phone || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.gender === 'M' ? 'Male' : u.gender === 'F' ? 'Female' : u.gender === 'O' ? 'Other' : '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.role || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.display_status === 'A' ? '<span class="status-active">Active</span>' : '<span class="status-inactive">Inactive</span>'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.class_id || u.current_class || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.batch_ids || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.subscription_type === 'D' ? 'Demo' : u.subscription_type === 'B' ? 'Basic' : u.subscription_type === 'P' ? 'Premium' : (u.subscription_type || '-')}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.joining_date || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.expiry_date || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">${u.created_at || '-'}</td>
                        <td style="padding:8px; border-bottom:1px solid #e9ecef;">
                            <button class="btn btn-secondary" onclick="openEditUser(${JSON.stringify(escapeHtmlForJson(u)).replace(/"/g, '&quot;')})" style="background:#17a2b8;">✏️ Edit</button>
                        </td>
                     </tr>
                `).join('')}
            </tbody>
        </table>
    </div>`;
}

// Helper function to escape HTML for JSON
function escapeHtmlForJson(obj) {
    return JSON.parse(JSON.stringify(obj).replace(/[\u00A0-\u9999<>\&]/gim, function(i) {
        return '&#' + i.charCodeAt(0) + ';';
    }));
}

window.openEditUser = function(user) {
    const modalHtml = `
        <div id="editUserModal" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:100000; display:flex; align-items:center; justify-content:center;">
            <div style="background:white; border-radius:12px; width:90%; max-width:600px; max-height:90vh; overflow-y:auto; box-shadow:0 10px 40px rgba(0,0,0,0.2);">
                <div style="padding:20px; border-bottom:1px solid #e9ecef; display:flex; justify-content:space-between; align-items:center;">
                    <h3 style="margin:0;">✏️ Edit User: ${escapeHtml(user.display_name || user.full_name)}</h3>
                    <button onclick="closeEditModal()" style="background:none; border:none; font-size:24px; cursor:pointer;">&times;</button>
                </div>
                <div style="padding:20px;">
                    <form id="editUserForm">
                        <input type="hidden" id="edit_user_id" value="${user.user_id}">
                        
                        <!-- Read-only user info -->
                        <div class="form-group">
                            <label>User ID:</label>
                            <input type="text" value="${user.user_id}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Full Name:</label>
                            <input type="text" value="${escapeHtml(user.display_name || user.full_name)}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Username:</label>
                            <input type="text" value="${escapeHtml(user.user_name)}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Gender:</label>
                            <input type="text" value="${user.gender === 'M' ? 'Male' : user.gender === 'F' ? 'Female' : user.gender === 'O' ? 'Other' : '-'}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Role:</label>
                            <input type="text" value="${user.role}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Class:</label>
                            <input type="text" value="${user.class_id || user.current_class || '-'}" readonly class="readonly-field">
                        </div>
                        <div class="form-group">
                            <label>Batch:</label>
                            <input type="text" value="${user.batch_ids || '-'}" readonly class="readonly-field">
                        </div>
                        
                        <hr>
                        
                        <!-- Editable fields -->
                        <div class="form-group">
                            <label>Email <span class="required">*</span></label>
                            <input type="email" id="edit_email" value="${escapeHtml(user.display_email || user.email_id || user.email || '')}" required>
                            <div class="error-message"></div>
                        </div>
                        
                        <div class="form-group">
                            <label>Mobile Number</label>
                            <input type="tel" id="edit_mobile" value="${user.display_mobile || user.mobile_number || user.phone || ''}" placeholder="10-digit mobile number">
                            <div class="error-message"></div>
                        </div>
                        
                        <div class="form-group">
                            <label>Status <span class="required">*</span></label>
                            <select id="edit_status" required>
                                <option value="A" ${user.display_status === 'A' ? 'selected' : ''}>Active</option>
                                <option value="I" ${user.display_status === 'I' ? 'selected' : ''}>Inactive</option>
                                <option value="B" ${user.display_status === 'B' ? 'selected' : ''}>Blocked</option>
                                <option value="D" ${user.display_status === 'D' ? 'selected' : ''}>Disabled</option>
                            </select>
                            <div class="error-message"></div>
                        </div>
                        
                        <div class="form-group">
                            <label>Subscription Type</label>
                            <select id="edit_subscription">
                                <option value="D" ${user.subscription_type === 'D' ? 'selected' : ''}>Demo</option>
                                <option value="B" ${user.subscription_type === 'B' ? 'selected' : ''}>Basic</option>
                                <option value="P" ${user.subscription_type === 'P' ? 'selected' : ''}>Premium</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label>Joining Date</label>
                            <input type="date" id="edit_joining_date" value="${user.joining_date || ''}">
                        </div>
                        
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" id="edit_expiry_date" value="${user.expiry_date || ''}">
                        </div>

                        <div style="display:flex; gap:10px; margin-top:20px;">
                            <button type="submit" class="btn-submit" style="background:#28a745;">💾 Save Changes</button>
                            <button type="button" onclick="closeEditModal()" class="btn-secondary" style="background:#6c757d;">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    setTimeout(() => {
        const form = document.getElementById('editUserForm');
        if (form) {
            form.onsubmit = async (e) => {
                e.preventDefault();
    
    // Validate email
                const email = document.getElementById('edit_email').value;
                if (!email || !validateEmail(email)) {
                    showFieldErrorInModal('edit_email', 'Valid email is required');
                    return;
                }
    
    // Build update data
                const updateData = {
                    user_id: parseInt(document.getElementById('edit_user_id').value),
                    email: email
                };
    
                const mobile = document.getElementById('edit_mobile').value;
                if (mobile) updateData.mobile_number = mobile;
    
                const status = document.getElementById('edit_status').value;
                if (status) updateData.user_status = status;
    
                const subscription = document.getElementById('edit_subscription').value;
                if (subscription) updateData.subscription_type = subscription;
    
                const joiningDate = document.getElementById('edit_joining_date').value;
                if (joiningDate) updateData.joining_date = joiningDate;
    
                const expiryDate = document.getElementById('edit_expiry_date').value;
                if (expiryDate) updateData.expiry_date = expiryDate;
    
                Swal.fire({ 
                    title: 'Updating...', 
                    text: 'Please wait', 
                    allowOutsideClick: false, 
                    didOpen: () => Swal.showLoading() 
                });
    
                try {
                    const res = await fetch(API_BASE + 'user_update.php', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(updateData)
                    });
        
                    const result = await res.json();
        
                    if (result.success) {
            // Close modal first
                        closeEditModal();
            
            // Show success message
                        Swal.fire({ 
                            icon: 'success', 
                            title: 'Updated!', 
                            text: result.message,
                            timer: 1500,
                            showConfirmButton: true
                        });
            
            // Force refresh the user history
                        if (activeUserContext && activeUserContext.schoolId) {
                // Refresh data
                            const updatedUsers = await refreshUserHistory(activeUserContext.schoolId);
                
                // Re-render the history table
                            const historyDiv = document.getElementById('userHistory');
                            if (historyDiv && updatedUsers.length > 0) {
                                historyDiv.innerHTML = renderUserHistoryTable(updatedUsers);
                            }
                
                // Also refresh the toggle content to ensure it's active
                            const activeContent = document.querySelector('.toggle-content.active-content');
                            if (activeContent && activeContent.id === 'userHistory') {
                    // Already showing history, keep it
                            } else {
                    // Switch to history tab to show updated data
                                showUserToggleContent('userHistory');
                            }
                        }
                    } else {
                        Swal.fire({ icon: 'error', title: 'Update Failed', text: result.message });
                    }
                } catch(error) {
                    console.error('Update error:', error);
                    Swal.fire({ icon: 'error', title: 'Error', text: error.message });
                }
            };
        }
    }, 100);
};

// Helper function to show field error in modal
function showFieldErrorInModal(inputId, message) {
    const input = document.getElementById(inputId);
    if (input) {
        input.classList.add('error');
        let errorDiv = input.parentElement.querySelector('.error-message');
        if (!errorDiv) {
            errorDiv = document.createElement('div');
            errorDiv.className = 'error-message';
            input.parentElement.appendChild(errorDiv);
        }
        errorDiv.style.display = 'block';
        errorDiv.innerHTML = message;
        errorDiv.style.color = '#dc3545';
        errorDiv.style.fontSize = '12px';
        errorDiv.style.marginTop = '5px';
        toastr.error(message);
    }
}

// Close edit modal
window.closeEditModal = function() {
    const modal = document.getElementById('editUserModal');
    if (modal) {
        modal.remove();
    }
};

// Validate email function
function validateEmail(email) {
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(email);
}

// Validate phone function
function validatePhone(phone) {
    const re = /^\d{10}$/;
    return re.test(phone);
}

